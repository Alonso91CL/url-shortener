---
import BaseLayout from '../layouts/BaseLayout.astro';
import 'sweetalert2/dist/sweetalert2.css';
---

<BaseLayout title="Crear cuenta">
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-6">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-accent-400 to-accent-600 rounded-xl flex items-center justify-center text-white font-bold shadow-glow-sm">
            L
          </div>
        </a>
        <h1 class="font-sans text-2xl font-semibold mb-2 text-ink-100">Crea tu cuenta</h1>
        <p class="text-ink-500">Empieza a acortar enlaces con analytics</p>
      </div>

      <div class="card p-8">
        <form id="registerForm" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium mb-2 text-ink-300">Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="input-base"
              placeholder="Tu nombre"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium mb-2 text-ink-300">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="input-base"
              placeholder="tu@email.com"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium mb-2 text-ink-300">Contraseña</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="new-password"
              minlength="8"
              class="input-base"
              placeholder="Mínimo 8 caracteres"
            />
            <p class="mt-1.5 text-2xs text-ink-600">Usa mayúsculas, minúsculas, números y símbolos</p>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium mb-2 text-ink-300">Confirmar contraseña</label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              autocomplete="new-password"
              class="input-base"
              placeholder="Repite tu contraseña"
            />
          </div>

          <button type="submit" class="btn btn-primary w-full py-3">
            <span id="submitText">Crear cuenta</span>
            <span id="submitLoader" class="hidden">
              <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
            </span>
          </button>
        </form>

        <div class="mt-6 text-center">
          <p class="text-ink-500 text-sm">
            ¿Ya tienes cuenta? <a href="/login" class="text-accent-400 hover:text-accent-300 font-medium">Inicia sesión</a>
          </p>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-ink-600">
        Al crear tu cuenta, aceptas nuestros <a href="#" class="text-ink-400 hover:text-ink-300">Términos de servicio</a> y <a href="#" class="text-ink-400 hover:text-ink-300">Política de privacidad</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import Swal from 'sweetalert2';

  const form = document.getElementById('registerForm') as HTMLFormElement;
  const submitText = document.getElementById('submitText') as HTMLSpanElement;
  const submitLoader = document.getElementById('submitLoader') as HTMLSpanElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitText.classList.add('hidden');
    submitLoader.classList.remove('hidden');
    
    const formData = new FormData(form);
    const name = formData.get('name');
    const email = formData.get('email');
    const password = formData.get('password');
    const confirmPassword = formData.get('confirmPassword');

    if (password !== confirmPassword) {
      await Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Las contraseñas no coinciden',
        background: '#1a1a1a',
        color: '#e5e5e5',
        confirmButtonColor: '#22c55e',
      });
      submitText.classList.remove('hidden');
      submitLoader.classList.add('hidden');
      return;
    }

    try {
      const response = await fetch('http://localhost:3000/api/v1/auth/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ name, email, password }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || data.message || 'Error al crear la cuenta');
      }

      localStorage.setItem('token', data.data.token);
      localStorage.setItem('user', JSON.stringify(data.data.user));

      await Swal.fire({
        icon: 'success',
        title: '¡Cuenta creada!',
        text: 'Redirigiendo al dashboard...',
        timer: 1500,
        showConfirmButton: false,
        background: '#1a1a1a',
        color: '#e5e5e5',
        confirmButtonColor: '#22c55e',
      });

      window.location.href = '/dashboard';
    } catch (error) {
      await Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error instanceof Error ? error.message : 'Error al crear la cuenta',
        background: '#1a1a1a',
        color: '#e5e5e5',
        confirmButtonColor: '#22c55e',
      });
    } finally {
      submitText.classList.remove('hidden');
      submitLoader.classList.add('hidden');
    }
  });
</script>
