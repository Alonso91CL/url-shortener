# =============================================================================
# URL Shortener - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control!

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://shortener:shortener_pass@localhost:5432/shortener

# Docker compose variables (used by docker-compose.yml)
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener_pass
POSTGRES_DB=shortener

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JWT Secret - MUST be at least 32 characters in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secret_key_min_32_chars
JWT_EXPIRES_IN=24h

# Bcrypt salt rounds (12 is recommended for production)
SALT_ROUNDS=12

# Salt for IP hashing (privacy compliance)
IP_HASH_SALT=your_ip_salt

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Base URL of the frontend application
APP_BASE_URL=http://localhost:4321

# API Port
API_PORT=3000

# -----------------------------------------------------------------------------
# Public URLs (exposed to client - must start with PUBLIC_)
# Used by frontend to generate short URLs and API calls
# -----------------------------------------------------------------------------
# Development:
PUBLIC_APP_BASE_URL=http://localhost:4321
PUBLIC_API_BASE_URL=http://localhost:3000
#
# Production (example):
# PUBLIC_APP_BASE_URL=https://linkly.pivotit.cl
# PUBLIC_API_BASE_URL=https://linkly.pivotit.cl

# Node environment
NODE_ENV=development

# CORS Origin (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:4321

# -----------------------------------------------------------------------------
# GeoIP Database
# -----------------------------------------------------------------------------
# Path to MaxMind GeoLite2 City database
# Download from: https://dev.maxmind.com/geoip/geoip2/geolite2/
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# -----------------------------------------------------------------------------
# BullMQ Worker
# -----------------------------------------------------------------------------
# Number of concurrent workers for click processing
BULL_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Window in milliseconds for rate limiting
RATE_LIMIT_WINDOW_MS=60000
# Max links creation per user per window
RATE_LIMIT_MAX_LINKS=10

# -----------------------------------------------------------------------------
# pgAdmin (Development Only)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@shortener.local
PGADMIN_PASSWORD=admin123
